{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd ../.. && pnpm install && pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": null,
  "workspaces": {
    "apps/dhg-baseline": {
      "root": "apps/dhg-baseline"
    },
    "apps/dhg-lovable": {
      "root": "apps/dhg-lovable",
      "sourceRoot": "apps/dhg-lovable",
      "buildCommand": "pnpm turbo build",
      "framework": "vite"
    },
    "apps/dhg-test": {
      "root": "apps/dhg-test"
    }
  },
  "functions": {
    "backend/core/app.py": {
      "runtime": "python3.11",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/core/app.py"
    },
    {
      "src": "/baseline/(.*)",
      "dest": "apps/dhg-baseline/dist/$1"
    },
    {
      "src": "/lovable/(.*)",
      "dest": "apps/dhg-lovable/dist/$1"
    },
    {
      "src": "/test/(.*)",
      "dest": "apps/dhg-test/dist/$1"
    }
  ],
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key"
  }
}