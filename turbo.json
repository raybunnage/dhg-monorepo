{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  },
  "pipeline": {
    "build": {
      "outputs": ["dist/**"]
    },
    "dhg-lovable#build": {
      "outputs": ["apps/dhg-lovable/dist/**"]
    }
  }
}
